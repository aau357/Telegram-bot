# === Telegram ===
# @BotFather dan olinadigan bot tokeni
BOT_TOKEN=

# === Musiqani tanib olish (Shazam kabi) uchun AudD.io API kaliti ===
# https://dashboard.audd.io/ saytidan ro'yxatdan o'tib bepul token oling
AUDD_API_TOKEN=

# === (Ixtiyoriy) Qo'shiq nomi/matni bo'yicha aniqroq qidirish uchun Genius API tokeni ===
# https://genius.com/api-clients dan oling. Bo'sh qoldirsangiz ham bot ishlayveradi,
# lekin qo'shiq nomi to'g'ridan-to'g'ri YouTube'da qidiriladi.
GENIUS_ACCESS_TOKEN=

# === API server porti (React mini-app shu portga ulanadi) ===
API_PORT=3001

# === Fayllar hajmi cheklovi (MB). Telegram bot API orqali yuborish uchun ===
MAX_FILE_SIZE_MB=48

# === (Ixtiyoriy) yt-dlp fayliga to'liq yo'l ===
# Bo'sh qoldirsangiz bot avval bot/bin/ papkasidan, keyin tizim PATH'idan qidiradi.
YTDLP_PATH=

# === (Ixtiyoriy) Xatolar haqida xabar keladigan chat ID ===
# Bu yerga o'z Telegram ID'ingizni yozsangiz, foydalanuvchilar oddiy xabar
# ko'rgan paytda, siz texnik tafsilotni shaxsiy xabarda olasiz.
# ID'ni bilish uchun @userinfobot ga yozing.
ADMIN_CHAT_ID=

# === (Ixtiyoriy) Video sifati — kichikroq = tezroq ===
VIDEO_MAX_HEIGHT=720

# === (Ixtiyoriy) SoundCloud uchun proxy ===
# Ba'zi tarmoqlarda soundcloud.com to'g'ridan-to'g'ri bloklangan bo'ladi.
# Shunday holatda bu yerga proxy manzilini yozing (masalan:
# http://user:parol@host:port yoki socks5://host:port). Faqat SoundCloud
# so'rovlari shu orqali yuboriladi — YouTube'ga taʼsir qilmaydi.
SOUNDCLOUD_PROXY=
